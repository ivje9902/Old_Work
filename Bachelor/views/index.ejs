  <script>
    // Toggle the visibility of the info box
    function toggleInfoBox(ans) {
      const infoBox = document.getElementById('infobox');

      if (ans == 'open') {
        infoBox.classList.add('grid');
        infoBox.classList.remove('hidden');
        infoBox.focus();
      }
      else {
        const cookieValue = getCookie('infoBoxClosed');

        if (cookieValue) {
        }
        else {
          infoBox.classList.add('grid');
          infoBox.classList.remove('hidden');
          infoBox.focus();

        }

      }
    }


    // Close the info box, depending on the button used to close it will decide how long the cookie will last
    function closeInfoBox(ans) {
      const infoBox = document.getElementById('infobox');

      if (ans) {
        infoBox.classList.add('hidden');
        infoBox.classList.remove('grid');
        setCookie('infoBoxClosed', 'true', 30);
      }

      else {
        infoBox.classList.add('hidden');
        infoBox.classList.remove('grid');
        setCookie('infoBoxClosed', 'true');
      }
    }

    // Close the info box when clicking outside of it
    document.addEventListener('click', function (event) {
      const infoBox = document.getElementById('infobox');
      const infoButton = document.getElementById('infoButton');
      if (!infoBox.contains(event.target) && !infoButton.contains(event.target)) {
        infoBox.classList.add('hidden');
      }
    });
  </script>


