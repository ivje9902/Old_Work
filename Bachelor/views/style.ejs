                        <label for="relevance-option-2" class="block ms-2 text-sm font-medium text-gray-900 ">
                            1-2
                        </label>
                    </div>

                    <div class="flex items-center mb-4">
                        <input id="relevance-option-3" type="radio" name="relevance" value="3"
                            class="w-4 h-4 border-gray-300 focus:ring-2 focus:ring-blue-300 ">
                        <label for="relevance-option-3" class="block ms-2 text-sm font-medium text-gray-900 ">
