        <script>
            function changeValue(id) {
                cbox_val = document.getElementById(id).value;
                if (cbox_val == "false") {
                    document.getElementById(id).value = "true";
                }
                else {
                    document.getElementById(id).value = "false";
                }
            }
        </script>

        <div class="place-self-left pr-10 mt-2 p-6 w-99/100 bg-white border border-gray-200 rounded-lg shadow-sm "
            id="evolve_parent" style="display: none;">
            <div id="evolve_title" class="invisible text-2xl font-bold mb-5">
            </div>
