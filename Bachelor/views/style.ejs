        <div id="feedback-form-container"
            class="fixed top-1/100 left-20/100 right-20/100 h-99/100 bg-opacity-0 flex items-center justify-center invisible">
            <form
                class="relative max-w-sm mx-auto place-self-center pr-10 p-6 w-99/100 bg-white border border-gray-200 rounded-lg shadow-sm"
                id="feedback-form">
                <fieldset class="pb-5">
                    <legend class="sr-only">Relevance</legend>
                    <button type="button" onclick="closeForm()"
                        style="position: absolute; top: 10px; right: 10px; background: white; padding: 8px; border-radius: 4px; border: none; cursor: pointer;">
