<body class="bg-[url(/images/bakgrund-test.jpg)] p-0 m-0" style="overflow-y: scroll;">


    <nav class=" w-99/100 z-20 left-0 start-0 text-[#00B7FF] bg-white border border-gray-200 rounded-lg shadow-sm mt-2">
        <ul class="flex flex-row">
            <img src="images/BlaGul_1000x200.png" class="h-20 p-3 col-start-1 col-end-2" alt="EU_Logo">
            <a href="https://www.regionorebrolan.se/" target="_blank">
                <img src="images/orebro.png" class="h-20 p-3 col-start-1- col-end-2" alt="Logo">
            </a>

            <a href="/" class="block font-bold text-xl p-7 hover:bg-gray-100" aria-current="page">Hem</a>
            <a href="upload" class="block font-bold text-xl p-7  hover:bg-gray-100 " aria-current="page">Energianalys</a>

            <button onclick="open_information('open')"
