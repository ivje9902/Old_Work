                        <label for="relevance-option-5" class="block ms-2 text-sm font-medium text-gray-900 ">
                            6+
                        </label>
                    </div>
                </fieldset>

                <fieldset class="pb-5">
                    <legend class="sr-only">Satisfaction</legend>
                    <label for="radio" class="block mb-2 text-sm font-medium text-gray-900 ">
                        <strong>Hur nöjd är du med verktyget på en skala 1-5?</strong>
                    </label>
                    <div class="flex items-center mb-4">
