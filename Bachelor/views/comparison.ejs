<!DOCTYPE html>
<html>

<head>
    <!-- Link to the external stylesheet -->
    <link rel="stylesheet" href="/stylesheets/style.css">
    <!-- Link to the external jsPDF file -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/3.0.1/jspdf.umd.min.js"></script>
    <!-- Link to the external marked.js file for Markdown parsing -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <!-- Link to the external JavaScript file -->
     <script src="/javascripts/response.js"></script>
    <script src="/javascripts/script.js"></script>
    <script src="/javascripts/eval.js"></script>
    <!-- Font Awesome for icons -->
    <script src="https://kit.fontawesome.com/db6d50f21f.js" crossorigin="anonymous"></script>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
</head>

<body>

    <button onclick="window.location.href = '/'">Lämna testversionen</button>
    <button onclick="window.location.href = '/evaluation'">Tillbaka till startsidan</button>
    
    <script>
        window.location.href = "/";
    </script>


    <h1>Jämförelse och Utvärdering</h1>
    <!-- Description of the page -->
    <p>Här är dina tips för att förbättra energieffektiviteten i din byggnad:</p>
    <p>För att börja jämföra, klicka på "Utveckla svar" knappen och se detaljerade tips.</p>
    <p>Observera att det kan ta en stund att generera och utveckla svar.</p>
    <p>För test- eller utvärderingsversionen är endast knappen 'Utveckla svar' tillgänglig.</p>
    <!-- Placeholder for the header -->
    <div class="header"></div>

    <div class="loader" id="loader">
    </div>

    <!-- Container for the tips (boxes with checkboxes) -->
    <div id="tips-row" style="display: flex; gap: 32px;">
        <div style="flex: 1; text-align: center;">
            <p>Svar utan RAG (Utan databas)</p>
            <div id="tips-container-ans"></div>
        </div>
    
        <div style="flex: 1; text-align: center;">
            <p>Svar med RAG (Med databas)</p>
            <div id="tips-container-rag"></div>
        </div>
    </div>

    <!-- Container for the button and spinner -->

    <div id="button-container" style="margin-top: 20px;">
        <!-- Button to process selected tips -->
        <button id="develop-button" class="btn btn-primary btn-lg opacity-50 cursor-not-allowed" disabled>
            Utveckla svaren
        </button>

        <!-- Loading spinner button (hidden by default) -->
        <button id="loading-button" class="btn btn-primary btn-lg" type="button" disabled style="display: none;">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            Genererar svar...
        </button>

        <button id="guide-button" class="btn btn-primary btn-lg" disabled>
            Steg för steg guide
        </button>

        <button id="loading-guide-button" class="btn btn-primary btn-lg" type="button" disabled style="display: none;">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"
                style="vertical-align: middle;"></span>
            Genererar guide...
        </button>

        <button id="energy-saving-button" class="btn btn-primary btn-lg" disabled>
            Energibesparingsberäkning
        </button>

        <button id="loading-saving-button" class="btn btn-primary btn-lg" type="button" disabled style="display: none;">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"
                style="vertical-align: middle;"></span>
            Genererar energibesparingsberäkning...
        </button>
    </div>


    <button id=" download-button"
        style="display: inline-block; padding: 10px; border: 1px solid #ccc; border-radius: 5px; cursor: pointer; background-color: rgb(255, 255, 255);"
        onclick="downloadTextFile()">
        <i class="fa-solid fa-download"></i> Ladda ner
    </button>

    <script>
        function downloadTextFile() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();

            const text = document.getElementById('result-text').innerText;

            const margin = 20;
            const pageWidth = doc.internal.pageSize.getWidth() - margin * 2;
            const fontSize = 10;

            doc.setFontSize(fontSize);

            const lines = doc.splitTextToSize(text, pageWidth);

            doc.text(lines, margin, margin);

            doc.save('svar.pdf');
        }


        document.addEventListener("DOMContentLoaded", () => {
            document.getElementById("develop-button").disabled = false;
            

            // Specify the buttons you want to disable
            const buttonsToDisable = [
                document.getElementById("offert-button"),
                document.getElementById("guide-button"),
                document.getElementById("energy-saving-button"),
                document.getElementById("form-button")
            ];

            // Disable all buttons except "Utveckla svar" and leave buttons
            buttonsToDisable.forEach((button) => {
                
                button.disabled = true;
                
            });
        });


    </script>

    <!-- Spinner (hidden by default) -->
    <div id="loading-spinner" class="spinner-grow" role="status"
        style="display: none; margin-top: 20px; vertical-align: middle; ">
        <span class="sr-only">Loading...</span>
    </div>

    <!-- Button to go back to the previous page 
    <button class="btn btn-secondary btn-lg" onclick="window.history.back();" style="position: absolute; top: 20px; left: 20px;">
        Tillbaka
    </button>  -->

    <!-- Big box to display selected tips with scrollable content -->
    <div class="result-box">
        <!-- Placeholder text for the result box -->

        <p id="result-text">
            Här kommer dina valda tips att visas.
        </p>
    </div>
    <div class="result-box" id="guide-box" style="display: none;">
        <p id="result-text2">
        </p>

    </div>
    <div class="result-box" id="energy-saving-box" style="display: none;">
        <p id="result-text3">
        </p>

    </div>

    <div id="button-container" style="margin-top: 20px;">
        <!-- Button to generate offert -->
        <button id="offert-button" class="btn btn-primary btn-lg" disabled>
            Skapa offertförfrågan
        </button>
        <button id="loading-offert-button" class="btn btn-primary btn-lg" type="button" style="display: none;" disabled>
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"
                style="vertical-align: middle;"></span>
            Genererar offert...

        </button>
    </div>

    <button id="form-button" class="btn btn-primary btn-lg" disabled>
        Utvärdering av verktyget
    </button>

    <div class="form-container" id="eval_form">
        <div class="form">
            <form action="#">
                <p>Hur nöjd är du med verktyget på en skala 1-5?</p>
                <label for="1">1 - Väldigt missnöjd.
                    <input type="radio" name="satisfaction" value="1">
                </label>

                <label for="2">2 - Relativt missnöjd
                    <input type="radio" name="satisfaction" value="2">
                </label>
                <label for="3">3 - Medelmåttigt
                    <input type="radio" name="satisfaction" value="3">
                </label>
                <label for="4">4 - Ganska nöjd
                    <input type="radio" name="satisfaction" value="4">
                </label>
                <label for="5">5 - Väldigt nöjd
                    <input type="radio" name="satisfaction" value="5">
                </label>

                <p>Hur många förslag var relevanta?</p>
                <label for="">0-1
                    <input type="radio" name="relevance" value="1">
                </label>
                <label for="">2-4
                    <input type="radio" name="relevance" value="2">
                </label>
                <label for="">5-6
                    <input type="radio" name="relevance" value="3">
                </label>

                <label for="extra">Vill du tillägga någonting?</label>
                <textarea name="" id=""></textarea>
                <button type="submit" class="form-button">Skicka</button>
                <button type="button" class="form-button" onclick="closeForm()">Close</button>
            </form>
        </div>
    </div>


    <script>
        load_page_testversion();
    </script>

    <div>
        <p id="expanded-answer"></p>
    </div>




</body>


</html>